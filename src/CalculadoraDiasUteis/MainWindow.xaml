<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CalculadoraDiasUteis.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CalculadoraDiasUteis"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Sem isso o WinUI mostraria "Esc" numa dica solta, por causa dos atalhos de voltar definidos aqui -->
    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <!-- Voltar da página "Sobre" pelo teclado -->
            <KeyboardAccelerator Key="Escape" Invoked="BackAccelerator_Invoked" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            AutomationProperties.AutomationId="AppTitleBar"
            BackRequested="AppTitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind RootFrame.CanGoBack, Mode=OneWay}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
