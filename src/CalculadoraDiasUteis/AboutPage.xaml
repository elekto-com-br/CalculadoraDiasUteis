<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CalculadoraDiasUteis.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CalculadoraDiasUteis"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="720"
            Padding="24,8,24,24"
            HorizontalAlignment="Left"
            Spacing="16">

            <!-- O logotipo completo leva ao site da Elekto -->
            <HyperlinkButton
                x:Uid="ElektoLink"
                Padding="0"
                AutomationProperties.AutomationId="ElektoLink"
                NavigateUri="https://elekto.com.br/">
                <Image Height="64" AutomationProperties.AccessibilityView="Raw">
                    <Image.Source>
                        <SvgImageSource UriSource="ms-appx:///Assets/logo-elekto.svg" />
                    </Image.Source>
                </Image>
            </HyperlinkButton>

            <StackPanel Spacing="4">
                <TextBlock
                    x:Uid="AboutTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    AutomationProperties.AutomationId="VersionText"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Version, Mode=OneTime}" />
                <TextBlock x:Uid="AboutCopyright" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBlock x:Uid="AboutPurpose" TextWrapping="Wrap" />
            <TextBlock x:Uid="AboutFree" TextWrapping="Wrap" />
            <HyperlinkButton
                x:Uid="SourceCodeLink"
                AutomationProperties.AutomationId="SourceCodeLink"
                NavigateUri="https://github.com/elekto-com-br/CalculadoraDiasUteis"
                Style="{StaticResource TextLinkStyle}" />

            <TextBlock x:Uid="AboutLicense" TextWrapping="Wrap" />
            <TextBlock x:Uid="AboutAlternativeLicense" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Uid="LicenseButton"
                    AutomationProperties.AutomationId="LicenseButton"
                    Click="LicenseButton_Click" />
                <Button
                    x:Uid="LicenseTranslationButton"
                    AutomationProperties.AutomationId="LicenseTranslationButton"
                    Click="LicenseTranslationButton_Click" />
            </StackPanel>

            <TextBlock
                x:Uid="AboutPrivacyTitle"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="AboutPrivacy" TextWrapping="Wrap" />
            <!-- Os endereços estão nos recursos porque mudam com o idioma -->
            <StackPanel Spacing="4">
                <HyperlinkButton
                    x:Uid="ElektoPrivacyLink"
                    AutomationProperties.AutomationId="ElektoPrivacyLink"
                    Style="{StaticResource TextLinkStyle}" />
                <HyperlinkButton
                    x:Uid="GitHubPrivacyLink"
                    AutomationProperties.AutomationId="GitHubPrivacyLink"
                    Style="{StaticResource TextLinkStyle}" />
            </StackPanel>

            <InfoBar
                x:Name="OpenErrorInfoBar"
                AutomationProperties.AutomationId="OpenErrorInfoBar"
                Severity="Warning" />
        </StackPanel>
    </ScrollViewer>
</Page>
