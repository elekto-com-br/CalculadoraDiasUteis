<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CalculadoraDiasUteis.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CalculadoraDiasUteis">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                A cor de destaque é o verde da Elekto (#556652), com os tons claros e escuros que os controles
                usam em cada tema. Os escolhidos dão contraste de pelo menos 4,5:1 ao texto sobre o destaque
                (Dark1 com branco no tema claro, Light2 com preto no escuro) e ao texto em destaque
                (Dark2 no claro, Light3 no escuro). No alto contraste valem as cores do Windows.
            -->
            <Color x:Key="SystemAccentColor">#556652</Color>
            <Color x:Key="SystemAccentColorDark1">#424F40</Color>
            <Color x:Key="SystemAccentColorDark2">#313B30</Color>
            <Color x:Key="SystemAccentColorDark3">#212820</Color>
            <Color x:Key="SystemAccentColorLight1">#6F856B</Color>
            <Color x:Key="SystemAccentColorLight2">#91A48E</Color>
            <Color x:Key="SystemAccentColorLight3">#B8C4B5</Color>

            <!-- Superfície dos cartões que agrupam cada conta -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!--
                Links em texto. Com o verde escuro como destaque, a cor do link fica perto da do texto comum;
                o sublinhado é o que o identifica
            -->
            <Style x:Key="TextLinkStyle" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="0" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <!-- O conteúdo é o próprio texto do link; neste dicionário o x:Bind não compila -->
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextDecorations="Underline" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
